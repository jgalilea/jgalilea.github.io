---
import type { Project } from '../lib/projects';
import { useTranslations, type Lang } from '../i18n/ui';
import { languageColor } from '../lib/languages';

interface Props {
  project: Project;
  lang: Lang;
}

// A visual tile: the preview fills the card and only the essentials sit on top.
// The full details live in the regular card further down.
const { project, lang } = Astro.props;
const t = useTranslations(lang);
const color = languageColor(project.language);
// Visitors can't open a private repo, so those tiles only link to the website.
const href = project.homepage ?? (project.private ? null : project.url);
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  target={href ? '_blank' : undefined}
  rel={href ? 'noopener' : undefined}
  class="group relative block aspect-[4/3] overflow-hidden rounded-2xl bg-slate-900 shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-lg hover:ring-sky-400 dark:ring-slate-800 dark:hover:ring-sky-600"
>
  {
    project.image ? (
      <img
        src={project.image}
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-105"
      />
    ) : (
      <div
        class="absolute inset-0"
        style={`background: radial-gradient(circle at 30% 20%, ${color}88, transparent 60%), radial-gradient(circle at 80% 90%, ${color}55, transparent 55%)`}
      />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>

  {
    project.private && (
      <span class="absolute top-3 left-3 rounded-full bg-amber-100/90 px-2 py-0.5 text-xs font-medium text-amber-900 backdrop-blur">
        {t('project.private')}
      </span>
    )
  }

  <div class="absolute inset-x-0 bottom-0 p-5">
    <h3 class="text-xl font-semibold text-white">{project.name}</h3>
    {project.summary && <p class="mt-1 line-clamp-2 text-sm text-slate-200">{project.summary}</p>}
    {
      href && (
        <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-sky-300 group-hover:text-sky-200">
          {project.homepage ? t('project.try') : t('project.code')}
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
      )
    }
  </div>
</Tag>
