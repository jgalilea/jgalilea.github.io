---
import '../styles/global.css';
import ProjectCard from '../components/ProjectCard.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getProjects, GITHUB_USER } from '../lib/projects';
import { defaultLang, homePath, locales, useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getProjects()).sort(
  (a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt),
);
const featured = projects.filter((p) => p.featured);

const title = `${profile.name} · ${t('meta.title')}`;
const description = t('meta.description', { name: profile.name, role: profile.role[lang].toLowerCase() });
const pageUrl = new URL(homePath(lang), Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// The contact block prefers email and falls back to LinkedIn.
const contact = profile.links.email
  ? { label: t('contact.email'), url: `mailto:${profile.links.email}` }
  : profile.links.linkedin
    ? { label: t('contact.linkedin'), url: profile.links.linkedin }
    : null;
const heading = 'text-2xl font-bold tracking-tight';

const countBy = (values: string[]) => {
  const counts = new Map<string, number>();
  for (const v of values) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const tags = countBy(projects.flatMap((p) => p.topics));
const languages = countBy(projects.flatMap((p) => (p.language ? [p.language] : [])));

const panelLabel = 'text-xs font-semibold tracking-wide text-slate-500 uppercase';
const chip =
  'rounded-full border px-2.5 py-0.5 text-sm transition border-slate-200 bg-white text-slate-700 hover:border-sky-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 aria-pressed:border-sky-600 aria-pressed:bg-sky-600 aria-pressed:text-white dark:aria-pressed:border-sky-500 dark:aria-pressed:bg-sky-500 dark:aria-pressed:text-slate-950';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      (Object.keys(locales) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(homePath(code), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLang), Astro.site)} />
    {
      lang === defaultLang && (
        <script is:inline>
          // First visit from a non-Spanish browser: send it to the English version.
          (() => {
            let saved = null;
            try {
              saved = localStorage.getItem('lang');
            } catch {}
            const prefersSpanish = navigator.languages.some((l) => l.toLowerCase().startsWith('es'));
            if (saved === 'en' || (!saved && !prefersSpanish)) location.replace('/en/' + location.search);
          })();
        </script>
      )
    }
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash.
      (() => {
        let theme = 'system';
        try {
          theme = localStorage.getItem('theme') ?? 'system';
        } catch {}
        const dark =
          theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <header class="relative flex flex-col gap-6 sm:flex-row sm:items-center">
        <div class="absolute top-0 right-0 flex flex-col items-end gap-2 sm:flex-row sm:items-center">
          <LanguageSwitcher lang={lang} />
          <ThemeSwitcher lang={lang} />
        </div>
        <img
          src={`https://github.com/${GITHUB_USER}.png?size=192`}
          alt=""
          width="96"
          height="96"
          class="h-24 w-24 rounded-full ring-4 ring-white dark:ring-slate-800"
        />
        <div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{profile.name}</h1>
          <p class="mt-2 text-lg text-slate-600 dark:text-slate-400">{profile.role[lang]}</p>
          <div class="mt-4">
            <SocialLinks lang={lang} />
          </div>
        </div>
      </header>

      <section class="mt-12 max-w-3xl" aria-labelledby="about">
        <h2 id="about" class={heading}>{t('about.title')}</h2>
        <div class="mt-4 space-y-3 text-lg leading-relaxed text-slate-700 dark:text-slate-300">
          {profile.about[lang].map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      {
        featured.length > 0 && (
          <section class="mt-16" aria-labelledby="featured">
            <h2 id="featured" class={heading}>
              {t('featured.title')}
            </h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {featured.map((project) => (
                <FeaturedCard project={project} lang={lang} />
              ))}
            </div>
          </section>
        )
      }

      <h2 id="projects" class:list={[heading, 'mt-16']}>{t('projects.title')}</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">
        {t('projects.intro')}{' '}
        <a href={`https://github.com/${GITHUB_USER}`} class="font-medium text-sky-700 hover:underline dark:text-sky-400"
          >github.com/{GITHUB_USER}</a
        >.
      </p>

      <section class="relative mt-6" aria-label={t('filters.label')}>
        <div class="flex flex-wrap gap-2">
          <label class="relative w-full sm:w-auto sm:flex-1">
            <span class="sr-only">{t('search.label')}</span>
            <svg
              class="pointer-events-none absolute top-1/2 left-3 h-5 w-5 -translate-y-1/2 text-slate-400"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.45 4.39l3.08 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.08A7 7 0 0 1 2 9Z"
                clip-rule="evenodd"></path></svg
            >
            <input
              id="search"
              type="search"
              placeholder={t('search.placeholder')}
              autocomplete="off"
              class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pr-4 pl-10 shadow-sm outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 dark:border-slate-700 dark:bg-slate-900"
            />
          </label>
          <button
            id="filters-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="filters-panel"
            class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 shadow-sm transition hover:border-sky-400 aria-expanded:border-sky-500 sm:flex-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 0 1 .628.74v2.288a2.25 2.25 0 0 1-.659 1.59l-4.682 4.683a2.25 2.25 0 0 0-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 0 1 8 18.25v-5.757a2.25 2.25 0 0 0-.659-1.591L2.659 6.22A2.25 2.25 0 0 1 2 4.629V2.34a.75.75 0 0 1 .628-.74Z"
                clip-rule="evenodd"></path></svg
            >
            {t('filters.button')}
            <span
              id="filters-badge"
              class="hidden min-w-5 rounded-full bg-sky-600 px-1.5 text-xs leading-5 text-white dark:bg-sky-500 dark:text-slate-950"
            ></span>
          </button>
          <label class="relative flex-1 sm:flex-none">
            <span class="sr-only">{t('sort.label')}</span>
            <select
              id="sort"
              class="w-full appearance-none rounded-xl border border-slate-200 bg-white py-2.5 pr-10 pl-4 text-sm text-slate-700 shadow-sm outline-none focus:border-sky-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
            >
              <option value="updated">{t('sort.updated')}</option>
              <option value="name">{t('sort.name')}</option>
              <option value="stars">{t('sort.stars')}</option>
            </select>
            <svg
              class="pointer-events-none absolute top-1/2 right-3.5 h-4 w-4 -translate-y-1/2 text-slate-400"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
              ><path
                fill-rule="evenodd"
                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"></path></svg
            >
          </label>
        </div>

        <div
          id="filters-panel"
          hidden
          class="absolute inset-x-0 top-full z-20 mt-2 space-y-4 rounded-xl border border-slate-200 bg-white p-4 shadow-lg sm:left-auto sm:w-[30rem] dark:border-slate-700 dark:bg-slate-900"
        >
          {
            languages.length > 0 && (
              <div>
                <p class={panelLabel}>{t('filters.languages')}</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {languages.map(([lang, n]) => (
                    <button type="button" class={chip} data-filter="language" data-value={lang} aria-pressed="false">
                      {lang} <span class="opacity-60">{n}</span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }
          {
            tags.length > 0 && (
              <div>
                <p class={panelLabel}>{t('filters.tags')}</p>
                <div class="mt-2 flex max-h-60 flex-wrap gap-1.5 overflow-y-auto">
                  {tags.map(([tag, n]) => (
                    <button type="button" class={chip} data-filter="tag" data-value={tag} aria-pressed="false">
                      #{tag} <span class="opacity-60">{n}</span>
                    </button>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
          <p
            id="count"
            aria-live="polite"
            data-all={t('count.all')}
            data-filtered={t('count.filtered')}
          >
            {t('count.all', { total: projects.length })}
          </p>
          <div id="active-filters" class="contents" data-remove={t('filters.remove')}></div>
          <button id="clear" type="button" class="hidden font-medium text-sky-700 hover:underline dark:text-sky-400">
            {t('filters.clear')}
          </button>
        </div>
      </section>

      <main id="grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
      </main>
      <p id="empty" class="hidden py-16 text-center text-slate-500">{t('empty')}</p>

      <footer class="mt-24 border-t border-slate-200 pt-12 dark:border-slate-800">
        {
          contact && (
            <section
              aria-labelledby="contact"
              class="mb-12 flex flex-col items-start justify-between gap-6 rounded-2xl bg-sky-50 p-8 sm:flex-row sm:items-center dark:bg-sky-950/40"
            >
              <div>
                <h2 id="contact" class={heading}>
                  {t('contact.title')}
                </h2>
                <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-300">{t('contact.text')}</p>
              </div>
              <a
                href={contact.url}
                target={contact.url.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener"
                class="shrink-0 rounded-lg bg-sky-600 px-5 py-3 font-medium text-white shadow-sm transition hover:bg-sky-700 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400"
              >
                {contact.label}
              </a>
            </section>
          )
        }
        <div class="flex flex-col items-center justify-between gap-4 text-sm text-slate-500 sm:flex-row dark:text-slate-400">
          <p>© {new Date().getFullYear()} {profile.name}</p>
          <SocialLinks lang={lang} variant="icons" />
        </div>
        <p class="mt-6 text-center text-xs text-slate-400 sm:text-left dark:text-slate-500">
          {t('footer', { date: new Date().toLocaleDateString(locales[lang], { dateStyle: 'long' }) })}
        </p>
      </footer>
    </div>

    <script>
      const grid = document.getElementById('grid')!;
      const cards = [...grid.querySelectorAll<HTMLElement>('.project')];
      const search = document.getElementById('search') as HTMLInputElement;
      const sort = document.getElementById('sort') as HTMLSelectElement;
      const count = document.getElementById('count')!;
      const empty = document.getElementById('empty')!;
      const clear = document.getElementById('clear')!;
      const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const toggleButton = document.getElementById('filters-toggle')!;
      const panel = document.getElementById('filters-panel')!;
      const badge = document.getElementById('filters-badge')!;
      const activeList = document.getElementById('active-filters')!;

      const active = { tag: new Set<string>(), language: new Set<string>() };

      const normalize = (s: string) =>
        s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

      // Read initial state from the URL so filtered views can be shared.
      const params = new URLSearchParams(location.search);
      search.value = params.get('q') ?? '';
      sort.value = params.get('sort') ?? 'updated';
      params.getAll('tag').forEach((t) => active.tag.add(t));
      params.getAll('lang').forEach((l) => active.language.add(l));

      function syncUrl() {
        const p = new URLSearchParams();
        if (search.value) p.set('q', search.value);
        if (sort.value !== 'updated') p.set('sort', sort.value);
        active.tag.forEach((t) => p.append('tag', t));
        active.language.forEach((l) => p.append('lang', l));
        const qs = p.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }

      function update() {
        const terms = normalize(search.value).split(/\s+/).filter(Boolean);
        let visible = 0;

        for (const card of cards) {
          const text = normalize(card.dataset.search!);
          const tags = card.dataset.tags!.split(',');
          const matches =
            terms.every((t) => text.includes(t)) &&
            [...active.tag].every((t) => tags.includes(t)) &&
            (active.language.size === 0 || active.language.has(card.dataset.language!));
          card.hidden = !matches;
          if (matches) visible++;
        }

        const key = sort.value;
        const sorted = [...cards].sort((a, b) =>
          key === 'name'
            ? a.dataset.name!.localeCompare(b.dataset.name!)
            : Number(b.dataset[key]) - Number(a.dataset[key]),
        );
        grid.append(...sorted);

        for (const chip of chips) {
          const set = active[chip.dataset.filter as keyof typeof active];
          const pressed = set.has(chip.dataset.value!);
          chip.setAttribute('aria-pressed', String(pressed));
        }

        // Active filters are listed next to the count, each one removable.
        const selected = [
          ...[...active.language].map((value) => ({ kind: 'language' as const, value, label: value })),
          ...[...active.tag].map((value) => ({ kind: 'tag' as const, value, label: `#${value}` })),
        ];
        activeList.replaceChildren(
          ...selected.map(({ kind, value, label }) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className =
              'inline-flex items-center gap-1 rounded-full bg-sky-100 px-2.5 py-0.5 font-medium text-sky-800 hover:bg-sky-200 dark:bg-sky-950 dark:text-sky-300 dark:hover:bg-sky-900';
            button.textContent = `${label} ×`;
            button.setAttribute('aria-label', activeList.dataset.remove!.replace('{name}', label));
            button.addEventListener('click', () => toggle(kind, value));
            return button;
          }),
        );
        badge.textContent = String(selected.length);
        badge.classList.toggle('hidden', selected.length === 0);

        const filtering = terms.length > 0 || active.tag.size > 0 || active.language.size > 0;
        const template = filtering ? count.dataset.filtered! : count.dataset.all!;
        count.textContent = template
          .replace('{visible}', String(visible))
          .replace('{total}', String(cards.length));
        empty.classList.toggle('hidden', visible > 0);
        clear.classList.toggle('hidden', !filtering);
        syncUrl();
      }

      function toggle(kind: keyof typeof active, value: string) {
        const set = active[kind];
        set.has(value) ? set.delete(value) : set.add(value);
        update();
      }

      chips.forEach((chip) =>
        chip.addEventListener('click', () =>
          toggle(chip.dataset.filter as keyof typeof active, chip.dataset.value!),
        ),
      );
      // Tag chips on the cards filter the project list too.
      document.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-tag-chip]');
        if (!chip) return;
        const outsideGrid = !grid.contains(chip);
        toggle('tag', chip.dataset.tagChip!);
        if (outsideGrid) document.getElementById('projects')!.scrollIntoView({ behavior: 'smooth' });
      });

      function setPanel(open: boolean) {
        panel.hidden = !open;
        toggleButton.setAttribute('aria-expanded', String(open));
      }
      toggleButton.addEventListener('click', () => setPanel(panel.hidden));
      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!panel.hidden && target.isConnected && !panel.contains(target) && !toggleButton.contains(target)) setPanel(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) {
          setPanel(false);
          toggleButton.focus();
        }
      });
      search.addEventListener('input', update);
      sort.addEventListener('change', update);
      clear.addEventListener('click', () => {
        search.value = '';
        active.tag.clear();
        active.language.clear();
        update();
      });

      update();
    </script>
  </body>
</html>
