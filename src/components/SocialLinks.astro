---
import { profile } from '../config';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** `buttons` shows logo and label; `icons` only the logo. */
  variant?: 'buttons' | 'icons';
}

const { lang, variant = 'buttons' } = Astro.props;
const t = useTranslations(lang);
const { github, linkedin, cv, email } = profile.links;

const links = [
  {
    label: t('links.github'),
    url: github,
    viewBox: '0 0 16 16',
    icon: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z',
  },
  {
    label: t('links.linkedin'),
    url: linkedin,
    viewBox: '0 0 24 24',
    icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: t('links.cv'),
    url: cv,
    viewBox: '0 0 20 20',
    icon: 'M4.5 2A1.5 1.5 0 0 0 3 3.5v13A1.5 1.5 0 0 0 4.5 18h11a1.5 1.5 0 0 0 1.5-1.5V7.621a1.5 1.5 0 0 0-.44-1.06l-4.12-4.122A1.5 1.5 0 0 0 11.378 2H4.5Zm2.25 8.5a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 3a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Z',
  },
  {
    label: t('links.email'),
    url: email && `mailto:${email}`,
    viewBox: '0 0 20 20',
    icon: 'M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Zm16 4.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z',
  },
].filter((link) => link.url);
---

<ul class:list={['flex flex-wrap', variant === 'icons' ? 'gap-2' : 'gap-3']}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.url}
          target={link.url.startsWith('mailto:') ? undefined : '_blank'}
          rel="noopener me"
          aria-label={variant === 'icons' ? link.label : undefined}
          title={variant === 'icons' ? link.label : undefined}
          class:list={[
            'inline-flex items-center border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-sky-500 dark:hover:text-sky-300',
            variant === 'icons' ? 'rounded-full p-2.5' : 'gap-2 rounded-lg px-4 py-2 text-sm font-medium',
          ]}
        >
          <svg class="h-4 w-4" viewBox={link.viewBox} fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={link.icon} />
          </svg>
          {variant === 'buttons' && link.label}
        </a>
      </li>
    ))
  }
</ul>
