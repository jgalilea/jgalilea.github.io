---
import type { Project } from '../lib/projects';
import { locales, useTranslations, type Lang } from '../i18n/ui';
import { languageColor } from '../lib/languages';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const tags = project.topics;
// A few tags are enough on the card; the rest still count for search and filters.
const MAX_TAGS = 3;
const shownTags = tags.slice(0, MAX_TAGS);
const moreTags = tags.slice(MAX_TAGS);
const color = languageColor(project.language);
const initials = project.name
  .split(/[-_\s]+|(?=[A-Z][a-z])/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');
const updated = new Date(project.updatedAt);
const searchText = [project.name, project.summary, project.language, ...tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  class="project group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:border-sky-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-sky-700"
  data-search={searchText}
  data-tags={tags.join(',')}
  data-language={project.language ?? ''}
  data-name={project.name.toLowerCase()}
  data-updated={updated.getTime()}
  data-stars={project.stars}
>
  <div
    class="aspect-[16/10] shrink-0 overflow-hidden border-b border-slate-100 bg-slate-100 dark:border-slate-800 dark:bg-slate-800"
  >
    {
      project.image ? (
        <img
          src={project.image}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center"
          style={`background: radial-gradient(circle at 30% 20%, ${color}55, transparent 60%), radial-gradient(circle at 80% 90%, ${color}33, transparent 55%)`}
        >
          <span class="font-mono text-4xl font-bold tracking-tight text-slate-400/80 dark:text-slate-500/80">
            {initials}
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <header class="flex items-start justify-between gap-3">
      <h3 class="flex flex-wrap items-center gap-2 text-lg font-semibold break-words text-slate-900 dark:text-slate-100">
        {project.name}
        {
          project.private && (
            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-300">
              <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z"
                />
              </svg>
              {t('project.private')}
            </span>
          )
        }
      </h3>
      {
        project.stars > 0 && (
          <span class="shrink-0 text-sm text-slate-500 dark:text-slate-400" title={t('project.stars')}>
            ★ {project.stars}
          </span>
        )
      }
    </header>

    <div class="mt-2 flex-1">
      <p data-summary class="line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        {project.summary ?? t('project.noDescription')}
      </p>
      <button
        type="button"
        data-summary-toggle
        data-more={t('project.more')}
        data-less={t('project.less')}
        aria-expanded="false"
        hidden
        class="mt-1 text-sm font-medium text-sky-700 hover:underline dark:text-sky-400"
      >
        {t('project.more')}
      </button>
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs">
          {shownTags.map((tag) => (
            <li>
              <button
                type="button"
                data-tag-chip={tag}
                class="text-slate-500 hover:text-sky-700 hover:underline dark:text-slate-400 dark:hover:text-sky-400"
              >
                #{tag}
              </button>
            </li>
          ))}
          {moreTags.length > 0 && (
            <li class="text-slate-400" title={moreTags.map((tag) => `#${tag}`).join(' ')}>
              +{moreTags.length}
            </li>
          )}
        </ul>
      )
    }

    <footer class="mt-4 flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
      {
        project.language && (
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full" style={`background-color: ${color}`} />
            {project.language}
          </span>
        )
      }
      <time datetime={project.updatedAt}>
        {updated.toLocaleDateString(locales[lang], { year: 'numeric', month: 'short' })}
      </time>
    </footer>

    {
      (!project.private || project.homepage) && (
        <div class="mt-4 flex gap-2 border-t border-slate-100 pt-4 dark:border-slate-800">
          {/* Visitors can't open a private repo, so it gets no code link. */}
          {!project.private && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
            >
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              {t('project.code')}
            </a>
          )}
          {project.homepage && (
            <a
              href={project.homepage}
              target="_blank"
              rel="noopener"
              class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-sky-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-sky-700 dark:bg-sky-500 dark:text-slate-950 dark:hover:bg-sky-400"
            >
              {t('project.try')}
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.29a1 1 0 1 0 1.42 1.42L15 6.41V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z" />
                <path d="M5 5a2 2 0 0 0-2 2v8c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<script>
  // Long descriptions are clamped to three lines; the toggle only shows when text is cut.
  // A ResizeObserver catches cards that start hidden by a filter or change width.
  const observer = new ResizeObserver((entries) => {
    for (const { target } of entries) {
      const summary = target as HTMLElement;
      const toggle = summary.nextElementSibling as HTMLButtonElement;
      if (toggle.getAttribute('aria-expanded') === 'true') continue;
      toggle.hidden = summary.scrollHeight <= summary.clientHeight + 1;
    }
  });
  for (const summary of document.querySelectorAll<HTMLElement>('[data-summary]')) {
    observer.observe(summary);
    const toggle = summary.nextElementSibling as HTMLButtonElement;
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      summary.classList.toggle('line-clamp-3', !expanded);
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? toggle.dataset.less! : toggle.dataset.more!;
    });
  }
</script>
